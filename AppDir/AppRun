#!/bin/bash

HERE="$(dirname "$(readlink -f "${0}")")"
export APPIMAGE_PATH="${APPIMAGE:-$(readlink -f "$0")}"
APPIMAGE_DIR="$(dirname "$APPIMAGE_PATH")"
APPS_DIR="$HOME/.local/share/applications"

if [[ "$1" == "--install" ]]; then
    mkdir -p "$APPS_DIR"
    echo "Installing desktop shortcuts and MIME types..."

    cat <<EOF > "$APPS_DIR/run-proton.desktop"
[Desktop Entry]
Name=Proton AppImage Launcher
Exec="$APPIMAGE_PATH" %f
Icon=steam
Type=Application
Terminal=false
Categories=Utility;
MimeType=application/x-ms-dos-executable;application/x-msi;application/x-msdownload;
EOF

    cat <<EOF > "$APPS_DIR/proton-explorer.desktop"
[Desktop Entry]
Name=Proton Explorer
Exec="$APPIMAGE_PATH" explorer
Icon=folder-wine
Type=Application
Terminal=false
Categories=Utility;
EOF

    cat <<EOF > "$APPS_DIR/proton-winecfg.desktop"
[Desktop Entry]
Name=Proton Winecfg
Exec="$APPIMAGE_PATH" winecfg
Icon=wine-winecfg
Type=Application
Terminal=false
Categories=Utility;
EOF

    cat <<EOF > "$APPS_DIR/proton-reboot.desktop"
[Desktop Entry]
Name=Proton Reboot (Kill)
Exec="$APPIMAGE_PATH" wineboot -k
Icon=folder-wine
Type=Application
Terminal=false
Categories=Utility;
EOF

    cat <<EOF > "$APPS_DIR/proton-cmd.desktop"
[Desktop Entry]
Name=Proton Command Prompt
Exec="$APPIMAGE_PATH" cmd
Icon=utilities-terminal
Type=Application
Terminal=false
Categories=Utility;
EOF

    cat <<EOF > "$APPS_DIR/proton-control.desktop"
[Desktop Entry]
Name=Proton Control Panel
Exec="$APPIMAGE_PATH" control
Icon=preferences-system
Type=Application
Terminal=false
Categories=Utility;
EOF

    chmod +x "$APPS_DIR"/run-proton.desktop \
             "$APPS_DIR"/proton-explorer.desktop \
             "$APPS_DIR"/proton-winecfg.desktop \
             "$APPS_DIR"/proton-reboot.desktop \
             "$APPS_DIR"/proton-cmd.desktop \
             "$APPS_DIR"/proton-control.desktop

    # Register default applications
    xdg-mime default run-proton.desktop application/x-ms-dos-executable
    xdg-mime default run-proton.desktop application/x-msi
    xdg-mime default run-proton.desktop application/x-msdownload

    update-desktop-database "$APPS_DIR" 2>/dev/null
    echo "Installation complete!"
    exit 0

elif [[ "$1" == "--uninstall" ]]; then
    echo "Removing shortcuts and resetting MIME types..."

    # Clear MIME default associations
    for mime in application/x-ms-dos-executable application/x-msi application/x-msdownload; do
        current_default=$(xdg-mime query default "$mime")
        if [[ "$current_default" == "run-proton.desktop" ]]; then
            # Revert default association by removing entry from mimeapps.list if present
            sed -i "/$mime=run-proton.desktop/d" "$HOME/.config/mimeapps.list" 2>/dev/null || true
        fi
    done

    # Remove shortcut files
    rm -f "$APPS_DIR/run-proton.desktop" \
          "$APPS_DIR/proton-explorer.desktop" \
          "$APPS_DIR/proton-winecfg.desktop" \
          "$APPS_DIR/proton-reboot.desktop" \
          "$APPS_DIR/proton-cmd.desktop" \
          "$APPS_DIR/proton-control.desktop"

    update-desktop-database "$APPS_DIR" 2>/dev/null
    echo "Uninstallation complete!"
    exit 0
fi

if [ -z "$1" ]; then
    if python3 -c "import tkinter" &>/dev/null; then
        python3 - << EOF
import os
import subprocess
import sys
import tkinter as tk
from tkinter import messagebox

appimage = os.getenv("APPIMAGE_PATH")

def execute(args):
    try:
        cmd = [appimage] + args
        subprocess.Popen(cmd)
    except Exception as e:
        messagebox.showerror("Error", f"Failed to execute command:\n{e}")

root = tk.Tk()
root.title("Proton Standalone")
root.geometry("340x280")
root.resizable(False, False)

frame = tk.Frame(root, padx=15, pady=15)
frame.pack(fill="both", expand=True)

label = tk.Label(frame, text="Proton Runner Options", font=("Helvetica", 11, "bold"))
label.pack(pady=(0, 10))

buttons = [
    ("Launch Wine Explorer", lambda: execute(["explorer"])),
    ("Launch Winecfg", lambda: execute(["winecfg"])),
    ("Kill Wine (wineboot -k)", lambda: execute(["wineboot", "-k"])),
    ("Install MIME Integration", lambda: execute(["--install"])),
    ("Uninstall MIME Integration", lambda: execute(["--uninstall"]))
]

for text, cmd in buttons:
    btn = tk.Button(frame, text=text, width=30, command=cmd)
    btn.pack(pady=3)

root.mainloop()
EOF
        exit 0
    else
        echo "Tkinter non-functional or not found. Falling back to default 'explorer'..."
        set -- "explorer"
    fi
fi

if [ -f "$1" ]; then
    REAL_PATH=$(readlink -f "$1")
    shift
    set -- "$REAL_PATH" "$@"
    echo "Resolved shortcut/link to: $REAL_PATH"
fi

PROTON_PREFIX="$APPIMAGE_DIR/protonprefix"

INTERNAL_PROTON_BASE="$PROTON_PREFIX/opt/Proton"
INTERNAL_PROTON_SCRIPT="$INTERNAL_PROTON_BASE/proton"

APPIMAGE_MARKER="$PROTON_PREFIX/.appimage_extracted"
if [ ! -f "$APPIMAGE_MARKER" ]; then
    echo "Extracting AppImage to $PROTON_PREFIX..."
    mkdir -p "$PROTON_PREFIX"

    cd "$PROTON_PREFIX"
    "$APPIMAGE_PATH" --appimage-extract >/dev/null 2>&1 || {
        echo "Error: Failed to extract AppImage"
        exit 1
    }

    if [ -d "$PROTON_PREFIX/squashfs-root" ]; then
        shopt -s dotglob
        mv "$PROTON_PREFIX/squashfs-root"/* "$PROTON_PREFIX"/ 2>/dev/null || true
        rmdir "$PROTON_PREFIX/squashfs-root" 2>/dev/null || true
        shopt -u dotglob
    fi

    touch "$APPIMAGE_MARKER"
    echo "AppImage extracted successfully!"
else
    echo "AppImage already extracted, skipping extraction..."
fi

export WINEPREFIX="$PROTON_PREFIX/pfx"
export STEAM_COMPAT_DATA_PATH="$PROTON_PREFIX"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$PROTON_PREFIX"
export WINEDLLPATH="$INTERNAL_PROTON_BASE/files/lib64/wine:$INTERNAL_PROTON_BASE/files/lib/wine"
export PROTON_DISABLE_LSTEAMCLIENT=1
export PROTON_NO_STEAM=1
export PROTON_USE_WOW64=1
export SDL_GAMECONTROLLER_IGNORE_DEVICES="$SDL_GAMECONTROLLER_IGNORE_DEVICES,0x057e/0x2009,0x057e/0x2006,0x057e/0x2007,0x0e6f/0x0180,0x0e6f/0x0184,0x0e6f/0x0185,0x0e6f/0x0188,0x20d6/0xa711,0x20d6/0xa714"
export SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD=1
export SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1
mkdir -p "$PROTON_PREFIX/gstreamer-1.0/"
export WINE_GST_REGISTRY_DIR="$PROTON_PREFIX/gstreamer-1.0/"
export PROTON_NO_ESYNC=0
export WINEESYNC=1
export PROTON_NO_FSYNC=0
export WINEFSYNC=1
export WINESYNC=1


SLR_ENTRY=""

#UMU_SLR="$HOME/.local/share/umu/steamrt3/_v2-entry-point"
#STEAM_SLR="$HOME/.local/share/Steam/steamapps/common/SteamLinuxRuntime_sniper/_v2-entry-point"

UMU_SLR="$HOME/.local/share/umu/steamrt4/_v2-entry-point"
STEAM_SLR="$HOME/.local/share/Steam/steamapps/common/SteamLinuxRuntime_4/_v2-entry-point"

if [ -f "$UMU_SLR" ]; then
    SLR_ENTRY="$UMU_SLR"
elif [ -f "$STEAM_SLR" ]; then
    SLR_ENTRY="$STEAM_SLR"
fi

if [ ! -f "$PROTON_PREFIX/tracked_files" ]; then
    echo "First run or prefix incomplete. Launching Proton..."
    if [ -f "$INTERNAL_PROTON_SCRIPT" ]; then
        if [ -n "$SLR_ENTRY" ]; then
            "$SLR_ENTRY" -- python3 "$INTERNAL_PROTON_SCRIPT" run winecfg
        else
            python3 "$INTERNAL_PROTON_SCRIPT" run winecfg
        fi
    fi
fi

echo "Launching Wine..."
if [ -f "$INTERNAL_PROTON_SCRIPT" ]; then
    if [ -n "$SLR_ENTRY" ]; then
        echo "Using Steam Linux Runtime: $SLR_ENTRY"
        exec "$SLR_ENTRY" -- python3 "$INTERNAL_PROTON_SCRIPT" run "$@"
    else
        echo "Steam Linux Runtime not found. Executing Proton directly..."
        exec python3 "$INTERNAL_PROTON_SCRIPT" run "$@"
    fi
fi

exit 1

